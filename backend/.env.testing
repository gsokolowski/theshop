# =============================================================================
# Testing / CI (local php artisan test, GitHub Actions, etc.)
# Laravel loads this name when APP_ENV=testing — not ".env.test".
# phpunit.xml also sets many of these; keep values aligned when you change one.
# CI option: cp .env.testing .env && php artisan test
# =============================================================================

APP_NAME=the-shop
APP_ENV=testing
APP_KEY=base64:61wk9THuGrQvrfIhCbdpMbUgPO7axEFZF3Q9KNBI4dw=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite in-memory — no MySQL required in CI
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

SESSION_DRIVER=array
SESSION_LIFETIME=120

CACHE_STORE=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
MAIL_MAILER=array

FILESYSTEM_DISK=local

# Safe placeholders; feature tests mock or avoid real calls where needed
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLIC_KEY=pk_test_placeholder

GOOGLE_CLIENT_ID=test
GOOGLE_CLIENT_SECRET=test
GOOGLE_REDIRECT_URI=http://localhost/api/v1/auth/google/callback

FRONTEND_URL=http://localhost:5173

VITE_APP_NAME=the-shop

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
