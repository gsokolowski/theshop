# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME=the-shop
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Public URL of this Laravel app (no trailing slash). Used for GOOGLE_REDIRECT_URI expansion.
# Sail + nginx gateway (recommended local): https://shop-local.codecreators.co.uk
# Host-only php artisan serve: http://127.0.0.1:8000
# Production: e.g. https://the-shop.codecreators.co.uk
APP_URL=https://shop-local.codecreators.co.uk

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# =============================================================================
# SAIL / DOCKER (local)
# Run from backend/: ./vendor/bin/sail up -d
# Hosts: add "127.0.0.1 shop-local.codecreators.co.uk" then open https://shop-local.codecreators.co.uk
# Certs: ../scripts/generate-local-certs.sh
# Docs: ../docs/SAIL.md
# =============================================================================
APP_PORT=80
FORWARD_HTTPS_PORT=443
FORWARD_DB_PORT=33060
FORWARD_REDIS_PORT=6380
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025
WWWUSER=1000
WWWGROUP=1000
# SPA API base used by the frontend container (same host as nginx gateway)
VITE_API_BASE_URL=https://shop-local.codecreators.co.uk/api/v1

# =============================================================================
# LOGGING
# =============================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================================================
# DATABASE
# Sail (default local): mysql service below.
# Host-only without Sail: sqlite file, or point DB_* at a local MySQL.
# =============================================================================
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=theshop
DB_USERNAME=sail
DB_PASSWORD=password

# SQLite alternative (no Sail / no MySQL):
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/backend/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# =============================================================================
# CACHE, QUEUE & BROADCAST
# =============================================================================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
# Sail: hostname "redis". Host-only Redis container/app: 127.0.0.1
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# =============================================================================
# MAIL
# Sail: Mailpit (SMTP mailpit:1025, UI http://localhost:8025).
# Host-only: log, or your SMTP (Mailtrap, etc.).
# =============================================================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# STRIPE (REQUIRED for payments)
# Get keys from https://dashboard.stripe.com/apikeys (Developers → API keys).
# - STRIPE_SECRET_KEY: sk_test_... or sk_live_...
# - STRIPE_PUBLIC_KEY: pk_test_... or pk_live_... (same mode as the secret key)
# Leaving these empty breaks checkout / payment flows.
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=

# =============================================================================
# GOOGLE OAUTH (REQUIRED for "Sign in with Google")
# 1. Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
#    → Application type: Web application.
# 2. Authorized redirect URIs: must match GOOGLE_REDIRECT_URI exactly (scheme, host, path).
#    Sail local example: https://shop-local.codecreators.co.uk/api/v1/auth/google/callback
#    Production example: https://the-shop.codecreators.co.uk/api/v1/auth/google/callback
# 3. Paste the Client ID and Client secret below.
# 4. After changing .env on the server: php artisan config:clear && php artisan config:cache
# Leaving these empty causes Google sign-in to fail (400 invalid_request, etc.).
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match a URI registered in Google Console. ${APP_URL} expands if APP_URL is set first.
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/google/callback"

# =============================================================================
# FRONTEND URL
# Used for OAuth redirects after login (token handoff to the SPA) and order confirmation
# email links to product pages ({FRONTEND_URL}/product/{slug}).
# Sail (same host): https://shop-local.codecreators.co.uk
# Host-only Vite: http://localhost:5173
# Production: e.g. https://the-shop.codecreators.co.uk
# Loaded via config('app.frontend_url') so it works with php artisan config:cache.
# =============================================================================
FRONTEND_URL=https://shop-local.codecreators.co.uk

# =============================================================================
# SANCTUM (optional)
# Comma-separated domains for stateful API auth. Defaults include localhost.
# =============================================================================
SANCTUM_STATEFUL_DOMAINS=shop-local.codecreators.co.uk,localhost,localhost:5173,127.0.0.1

# =============================================================================
# AWS S3 (optional, for file storage)
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =============================================================================
# VITE / FRONTEND BUILD
# =============================================================================
VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# DEBUG BAR (optional, local development)
# =============================================================================
# DEBUGBAR_ENABLED=true
# DEBUGBAR_OPEN_STORAGE=true

# =============================================================================
# TESTING / CI
# See .env.testing (committed) for SQLite in-memory and safe defaults.
# GitHub Actions: e.g. cp .env.testing .env && composer install && php artisan test
# =============================================================================
