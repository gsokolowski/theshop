# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Public URL of this Laravel app (no trailing slash). Used for GOOGLE_REDIRECT_URI expansion.
# Production: e.g. https://the-shop.codecreators.co.uk if the API lives on that host.
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# =============================================================================
# LOGGING
# =============================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================================================
# DATABASE
# Supported: sqlite, mysql, pgsql
# For MySQL/PostgreSQL, uncomment and set the variables below.
# =============================================================================
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# =============================================================================
# CACHE, QUEUE & BROADCAST
# =============================================================================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =============================================================================
# MAIL
# Required for order confirmation emails and other transactional mail.
# MAIL_MAILER: log (dev, logs to storage), smtp (Mailtrap, Gmail, etc.)
# For SMTP: set MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD, MAIL_ENCRYPTION
# =============================================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# STRIPE (REQUIRED for payments)
# Get keys from https://dashboard.stripe.com/apikeys (Developers → API keys).
# - STRIPE_SECRET_KEY: sk_test_... or sk_live_...
# - STRIPE_PUBLIC_KEY: pk_test_... or pk_live_... (same mode as the secret key)
# Leaving these empty breaks checkout / payment flows.
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=

# =============================================================================
# GOOGLE OAUTH (REQUIRED for "Sign in with Google")
# 1. Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
#    → Application type: Web application.
# 2. Authorized redirect URIs: must match GOOGLE_REDIRECT_URI exactly (scheme, host, path).
#    Example if Laravel is served at https://the-shop.codecreators.co.uk :
#    https://the-shop.codecreators.co.uk/api/v1/auth/google/callback
# 3. Paste the Client ID and Client secret below.
# 4. After changing .env on the server: php artisan config:clear && php artisan config:cache
# Leaving these empty causes Google sign-in to fail (400 invalid_request, etc.).
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match a URI registered in Google Console. ${APP_URL} expands if APP_URL is set first.
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/google/callback"

# =============================================================================
# FRONTEND URL
# Used for OAuth redirects after login (token handoff to the SPA).
# Production: set to your public site origin, e.g. https://the-shop.codecreators.co.uk
# Loaded via config('app.frontend_url') so it works with php artisan config:cache.
# =============================================================================
FRONTEND_URL=http://localhost:5173

# =============================================================================
# SANCTUM (optional)
# Comma-separated domains for stateful API auth. Defaults include localhost.
# =============================================================================
# SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1

# =============================================================================
# AWS S3 (optional, for file storage)
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =============================================================================
# VITE / FRONTEND BUILD
# =============================================================================
VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# DEBUG BAR (optional, local development)
# =============================================================================
# DEBUGBAR_ENABLED=true
# DEBUGBAR_OPEN_STORAGE=true

# =============================================================================
# TESTING / CI
# See .env.testing (committed) for SQLite in-memory and safe defaults.
# GitHub Actions: e.g. cp .env.testing .env && composer install && php artisan test
# =============================================================================
