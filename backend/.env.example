# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# =============================================================================
# LOGGING
# =============================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================================================
# DATABASE
# Supported: sqlite, mysql, pgsql
# For MySQL/PostgreSQL, uncomment and set the variables below.
# =============================================================================
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# =============================================================================
# CACHE, QUEUE & BROADCAST
# =============================================================================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =============================================================================
# MAIL
# Required for order confirmation emails and other transactional mail.
# MAIL_MAILER: log (dev, logs to storage), smtp (Mailtrap, Gmail, etc.)
# For SMTP: set MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD, MAIL_ENCRYPTION
# =============================================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# STRIPE (REQUIRED for payments)
# Get keys from https://dashboard.stripe.com/apikeys
# Use test keys (pk_test_*, sk_test_*) for development.
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=

# =============================================================================
# GOOGLE OAUTH (REQUIRED for "Sign in with Google")
# Create credentials at https://console.cloud.google.com/apis/credentials
# Add authorized redirect URI: {APP_URL}/api/v1/auth/google/callback
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/google/callback"

# =============================================================================
# FRONTEND URL
# Used for OAuth redirects after login. Must match your Vite dev server or production URL.
# =============================================================================
FRONTEND_URL=http://localhost:5173

# =============================================================================
# SANCTUM (optional)
# Comma-separated domains for stateful API auth. Defaults include localhost.
# =============================================================================
# SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1

# =============================================================================
# AWS S3 (optional, for file storage)
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =============================================================================
# VITE / FRONTEND BUILD
# =============================================================================
VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# DEBUG BAR (optional, local development)
# =============================================================================
# DEBUGBAR_ENABLED=true
# DEBUGBAR_OPEN_STORAGE=true
