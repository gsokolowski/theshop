# Must include /api/v1 — no trailing slash.
#
# Local without Sail (php artisan serve + npm run dev on host):
#   VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
#   (omit VITE_HMR_*)
#
# Local with Sail + nginx gateway (same host as SPA):
#   VITE_API_BASE_URL=https://shop-local.codecreators.co.uk/api/v1
#   VITE_HMR_HOST=shop-local.codecreators.co.uk
#   VITE_HMR_PROTOCOL=wss
#   VITE_HMR_CLIENT_PORT=443
#
# .env.development — local npm run dev (committed)
# .env.production — npm run build (committed; override with .env.production.local if needed)

VITE_API_BASE_URL=https://shop-local.codecreators.co.uk/api/v1
VITE_HMR_HOST=shop-local.codecreators.co.uk
VITE_HMR_PROTOCOL=wss
VITE_HMR_CLIENT_PORT=443
