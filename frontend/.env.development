# Sail + nginx gateway (shop-local.codecreators.co.uk). For host-only php artisan serve, use:
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
# and remove VITE_HMR_* below.
VITE_API_BASE_URL=https://shop-local.codecreators.co.uk/api/v1
VITE_HMR_HOST=shop-local.codecreators.co.uk
VITE_HMR_PROTOCOL=wss
VITE_HMR_CLIENT_PORT=443
